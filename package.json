{
  "name": "asj-portal",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "PT Amanah Sakura Japan - Portal Lowongan (static frontend + rebuilt Netlify Functions backend)",
  "scripts": {
    "e2e": "node e2e/login-check.mjs",
    "e2e:share": "node e2e/share-view.mjs",
    "e2e:upload": "node e2e/upload-check.mjs",
    "e2e:biodata": "node e2e/biodata-check.mjs",
    "e2e:upsert": "node e2e/upsert-check.mjs",
    "dedupe": "node scripts/dedupe-duplicates.mts",
    "dedupe:apply": "node scripts/dedupe-duplicates.mts --apply",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-i18n.mts",
    "bundle:size": "node scripts/bundle-size-report.mts",
    "bundle:analyze": "node scripts/bundle-analyze.mts",
    "generate-api-docs": "node scripts/generate-api-docs.mts",
    "check:i18n": "node scripts/check-i18n.mts",
    "ship": "bash scripts/ship.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commitlint": "commitlint --from HEAD~1 --to HEAD --verbose",
    "hook:install": "git config core.hooksPath .githooks",
    "prepare": "git config core.hooksPath .githooks || true",
    "build:css": "tailwindcss -i ./src/main.css -o ./assets/main.css --minify",
    "build:i18n-jp": "npx tsx scripts/build-i18n-jp.mts",
    "build:js": "node scripts/build-js.mts",
    "watch:js": "node scripts/watch-js.mts",
    "dev": "node scripts/watch-js.mts --serve",
    "build:html": "node scripts/build-html.mts",
    "deploy": "node scripts/deploy-netlify.mts",
    "check:globals": "node scripts/check-globals.mts",
    "check:handlers": "node scripts/check-handlers.mts",
    "build": "npx tsc --noEmit && node scripts/check-globals.mts && node scripts/check-handlers.mts && npx @tailwindcss/cli -i ./src/main.css -o ./assets/main.css --minify && npx tsx scripts/build-i18n-jp.mts && node scripts/build-html.mts && node scripts/build-js.mts"
  },
  "dependencies": {
    "@sentry/browser": "^10.74.0",
    "@types/archiver": "^8.0.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "mammoth": "^1.12.2",
    "pdf-parse": "^2.4.5",
    "web-vitals": "^6.2.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@sentry/cli": "^3.7.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.2",
    "esbuild-visualizer": "^0.7.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "netlify-cli": "^27.3.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "qrcode-generator": "^2.0.4",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
